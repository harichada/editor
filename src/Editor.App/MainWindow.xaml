<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Editor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:render="using:Editor.App.Rendering">
  <Grid x:Name="Root" RowSpacing="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <MenuBar x:Name="Menu" Grid.Row="0"/>
    <render:EditorSurface x:Name="Surface" Grid.Row="1"/>

    <Grid x:Name="FindBar" Grid.Row="2" Padding="12,8" ColumnSpacing="8" RowSpacing="6" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="FindBox" PlaceholderText="Find" KeyDown="OnFindKeyDown"/>
      <TextBox x:Name="ReplaceBox" Grid.Column="1" PlaceholderText="Replace with" KeyDown="OnFindKeyDown"/>
      <CheckBox x:Name="MatchCaseBox" Grid.Column="2" Content="Match case" VerticalAlignment="Center"/>
      <Button Grid.Column="3" Content="Next" Click="OnFindNext"/>
      <Button Grid.Column="4" Content="Replace" Click="OnReplaceOne"/>
      <Button Grid.Column="5" Content="Replace all" Click="OnReplaceAll"/>
      <Button Grid.Column="6" Content="Close" Click="OnCloseFind"/>
      <TextBlock x:Name="FindStatus" Grid.Row="1" Grid.ColumnSpan="7" Opacity="0.8"/>
    </Grid>

    <Grid x:Name="StatusBar" Grid.Row="3" Padding="12,6" ColumnSpacing="18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="LineColumnText" VerticalAlignment="Center" Text="Line 1, Column 1"/>
      <TextBlock x:Name="ModifiedText" Grid.Column="1" VerticalAlignment="Center" Opacity="0.7"/>
      <Button x:Name="EndingButton" Grid.Column="3" Padding="8,2" Click="OnEndingClick"/>
      <TextBlock x:Name="EncodingText" Grid.Column="4" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</Window>
